{
  "name": "gym-api-nestjs",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "deploy": "nest deploy",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "lint": "oxlint --type-aware src/ test/",
    "architecture:check": "node scripts/check-architecture.mjs",
    "test:architecture": "node --test scripts/check-architecture.test.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "docs:openapi": "npm run build && node dist/infra/openapi/export-openapi.js",
    "docs:types": "npm exec --yes --package=typescript@5.9.3 --package=openapi-typescript@7.13.0 -- openapi-typescript openapi/openapi.json --output openapi/api-types.d.ts",
    "db:migrate": "prisma migrate deploy --config prisma7.config.ts",
    "db:migrate:dev": "prisma migrate dev --config prisma7.config.ts",
    "db:migrate:deploy": "prisma migrate deploy --config prisma7.config.ts",
    "db:migrate:status": "prisma migrate status --config prisma7.config.ts",
    "db:validate": "prisma validate --config prisma7.config.ts",
    "db:reset": "prisma migrate reset --config prisma7.config.ts --force",
    "db:seed": "prisma db seed --config prisma7.config.ts",
    "db:generate": "prisma generate --config prisma7.config.ts",
    "docker:start": "docker compose up -d",
    "prepare": "husky",
    "config:validate": "tsx scripts/validate-env.ts",
    "security:audit:prod": "npm audit --omit=dev --audit-level=high",
    "security:audit:critical": "npm audit --audit-level=critical",
    "imports:smoke": "node --input-type=module -e \"import { validateEnv } from '#src/common/config/env.validation'; import { Prisma } from '#prisma/client'; if (typeof validateEnv !== 'function' || !Prisma) process.exit(1); console.log('Native ESM aliases resolved')\""
  },
  "dependencies": {
    "@nestjs/authentication": "^0.1.5",
    "@nestjs/authorization": "^0.1.3",
    "@nestjs/common": "^12.4.0",
    "@nestjs/config": "^12.1.1",
    "@nestjs/core": "^12.4.0",
    "@nestjs/mail": "^0.0.2",
    "@nestjs/platform-express": "^12.4.0",
    "@nestjs/schedule": "^12.0.3",
    "@nestjs/swagger": "12.1.1",
    "@nestjs/throttler": "^6.7.1",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "ioredis": "^6.0.0",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.12",
    "@nestjs/mau": "^0.2.9",
    "@nestjs/schematics": "^12.0.12",
    "@nestjs/testing": "^12.4.0",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.0",
    "@types/node": "^26.6.6",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^5.1.0",
    "dotenv": "^18.0.9",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxlint": "^1.92.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.4.2",
    "prisma": "^7.10.1",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "oxlint --type-aware"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --check"
    ]
  },
  "allowScripts": {
    "@prisma/engines@7.10.1": true,
    "prisma@7.10.1": true,
    "bcrypt@6.0.0": true
  },
  "imports": {
    "#src/*": {
      "types": "./src/*.ts",
      "default": "./dist/*.js"
    },
    "#prisma/*": {
      "types": "./src/infra/database/generated/prisma/*.ts",
      "default": "./dist/infra/database/generated/prisma/*.js"
    }
  }
}
