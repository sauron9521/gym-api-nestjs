# Keep legacy output ignored during local branch migration.
/src/generated/

# Local managed avatars (not tracked by git)
uploads/

# Generated OpenAPI artifacts
/openapi/openapi.json
/openapi/api-types.d.ts

# Private operator SLO preflight, review, and rollout evidence artifacts.
# Commit only *.example.json templates, never actual operator evidence.
*.slo-preflight.json
*.slo-review.json
*.slo-evidence.json
.slo-evidence/

# Actual private post-rollout snapshots and manually exported change records.
*.slo-change-record.json
*.slo-postrollout.json
*.slo-baseline-inventory.json
*.slo-current-inventory.json

# Restricted SLO signing and replay history (templates use *.example.json).
*.slo-approval.json
*.slo-signature
*.slo-provenance.jsonl
*.slo-provenance.jsonl.lock
*.slo-trusted-key.pem

# Operator-only root-signed policy, detached signatures and pinned ledger refs.
*.slo-key-policy.json
*.slo-policy-signature
*.slo-key-root.pem
*.slo-key-policy-pin.json

# Local ephemeral staging evidence; never commit a private run receipt.
/staging/evidence.json

# Private synthetic staging credentials must never enter Git/artifacts.
/staging/functional-state.json
/staging/functional-evidence.json

# Runner-only two-release staging rehearsal progress and safe evidence.
/staging/upgrade-phase-state.json
/staging/upgrade-evidence.json

# Private release readiness review inputs, outputs and operator approvals.
/readiness/
*.private-production-change-approval.json
*.production-release-evidence.json
*.production-operator-approval.json
