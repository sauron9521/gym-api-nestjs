# Copy to /etc/gym-api/backup.env (owner root, mode 0600).
# Never put this file in git or expose it in logs/tickets.
# Supply DATABASE_URL from a dedicated read-only pg_dump role with all needed grants.
DATABASE_URL=
# Confirm the exact Compose-created Docker volume name.
AVATAR_VOLUME=gym-api_avatars
# The backup timer is daily; 26 hours tolerates minor scheduling delays.
BACKUP_MAX_AGE_HOURS=26
