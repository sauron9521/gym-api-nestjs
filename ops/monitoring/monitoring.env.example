# Place a locally adjusted copy at /etc/gym-api/monitoring.env.
# No passwords, JWTs, bearer tokens, or untrusted URLs should appear here.
# Exact Docker container name; see: docker ps --format '{{.Names}}'
API_CONTAINER=gym-api-api-1
# Monitoring origin as reachable from the operator host (not arbitrary path).
MONITOR_API_ORIGIN=http://127.0.0.1:3000
# Existing node_exporter textfile directory; must be writable by gym-monitor.
MONITOR_TEXTFILE_PATH=/var/lib/node_exporter/textfile_collector/gym_api_monitor.prom
