# Install a locally adjusted copy at /etc/gym-api/monitoring.env.
# The JSONL file must be generated and rotated by a separate trusted
# log-forwarding service; the monitoring user may only read it.
MONITOR_LOG_FILE=/var/log/gym-api/events.jsonl
# Monitoring origin as reachable from the operator host (no credentials/path).
MONITOR_API_ORIGIN=http://127.0.0.1:3000
# Existing node_exporter directory, writable by gym-monitor.
MONITOR_TEXTFILE_PATH=/var/lib/node_exporter/textfile_collector/gym_api_monitor.prom
